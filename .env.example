# ── Shared ────────────────────────────────────────────────────────────────
STELLAR_NETWORK=stellar:testnet            # CAIP-2 id (stellar:testnet | stellar:pubnet)
# x402 mode: "mock" runs the whole demo offline; "live" uses the OZ Channels facilitator
X402_MODE=live

# ── Risk Oracle (agents/oracle_provider) ───────────────────────────────────
ORACLE_PORT=3001
ORACLE_PRICE=$0.05                          # price per trust-score evaluation
RISK_AGENT_URL=http://localhost:8000        # internal risk_agent service
# x402 LIVE only:
STELLAR_RECIPIENT=                          # G... address that receives USDC
OZ_API_KEY=                                 # OZ Channels key (required on mainnet)
FACILITATOR_URL=https://channels.openzeppelin.com/x402/testnet
# Verifying keys produced by circuits/build.sh (optional in mock mode):
SOLVENCY_VK=../../circuits/solvency_proof/build/verification_key.json
REPAYMENT_VK=../../circuits/repayment_proof/build/verification_key.json

# ── x402 buyer (x402/client.mjs) — the lending protocol's wallet ────────────
STELLAR_SECRET_KEY=                         # S... secret with USDC trustline + balance

# ── Frontend (frontend/) ────────────────────────────────────────────────────
ORACLE_URL=http://localhost:3001            # frontend → oracle bridge

# ── Contract deployment (scripts/deploy.sh) ─────────────────────────────────
STELLAR_SOURCE=zkcredit-deployer            # stellar CLI identity name
PROTOCOL_ID=1
USDC_SAC=                                    # USDC SAC contract id on the target network
